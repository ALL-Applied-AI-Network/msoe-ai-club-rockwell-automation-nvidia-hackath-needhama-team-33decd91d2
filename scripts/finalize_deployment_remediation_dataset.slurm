#!/usr/bin/env bash
# Finalize a dataset generated by independent per-node shard jobs.
#SBATCH --job-name=remediation-finalize
#SBATCH --partition=teaching
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=00:30:00
#SBATCH --output=logs/remediation-finalize-%j.out
#SBATCH --error=logs/remediation-finalize-%j.err

set -euo pipefail

REPO_DIR="${SLURM_SUBMIT_DIR:-$PWD}"
cd "$REPO_DIR"
mkdir -p logs

OUT="${1:?dataset output path is required}"
SCENES="${2:-1000}"
TRAIN_COUNT="${3:-800}"
VAL_COUNT="${4:-100}"
SHARDS="${5:-4}"

srun --ntasks=1 python3 scripts/finalize_deployment_remediation_dataset.py \
  --out "$OUT" --scenes "$SCENES" --train-count "$TRAIN_COUNT" \
  --val-count "$VAL_COUNT" --num-shards "$SHARDS"
